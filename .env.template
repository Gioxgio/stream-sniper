# stream-sniper environment template.
#
# Copy to .env and fill in. docker-compose loads .env automatically
# (compose also reads the host environment, so values left empty here
# fall through to what the shell exports). Nothing here is required:
# every variable has a working default or disables the feature it
# controls. Real credentials stay out of git - .env is ignored.

# --- Twitch credentials: needed for live-state probing ---
# Get a client id/secret from https://dev.twitch.tv/console (an app
# with no redirect URI is fine). TWITCH_TOKEN, when set, is used as a
# user access token instead of the client-id/secret pair.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_TOKEN=

# --- Where ffmpeg-quiet/ffprobe live (optional) ---
# Point this at the install prefix's libexec/ (make install puts them
# in /usr/local/libexec/stream-sniper), or leave unset to resolve the
# wrappers next to the stream-sniper binary.
SS_WRAPPER_DIR=

# --- Recording notifications (optional) ---
# Base URL of the notification endpoint; stream-sniper POSTs
# {"message": "<text>"} to <base>/notifications on every recording
# start/stop. Full URL, not just a port: host and port both change
# between docker setups. Unset = notifications off.
# Example: SS_NOTIFY_URL=http://192.168.1.50:9000
SS_NOTIFY_URL=
